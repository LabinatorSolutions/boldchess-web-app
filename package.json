{
	"name": "boldchess-web-app",
	"version": "2.0.0",
	"description": "The official chess web app of BoldChess.com",
	"main": "server.js",
	"scripts": {
		"ci": "node scripts/generate-headers.js --check && biome ci . && bun test",
		"start": "node server.js",
		"build": "node scripts/generate-headers.js",
		"test": "bun test",
		"smoke": "node scripts/browser-smoke.js",
		"test:deep": "PERFT_DEEP=1 bun test",
		"test:update": "UPDATE_SNAPSHOTS=1 bun test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "echo 'No typecheck required'",
		"preview": "bun run start"
	},
	"keywords": [
		"chess",
		"game",
		"nodejs",
		"express"
	],
	"author": "BoldChess Team",
	"license": "AGPLv3",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LabinatorSolutions/boldchess-web-app.git"
	},
	"dependencies": {
		"compression": "^1.8.1",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.0",
		"helmet": "^8.3.0",
		"morgan": "^1.12.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=24.19.0"
	}
}
